{
  "name": "votive",
  "private": true,
  "version": "1.1.0",
  "workspaces": [
    "shared",
    "backend",
    "app",
    "prompt-service",
    "worker",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w worker && npm run build -w prompt-service && npm run build -w app",
    "build:shared": "npm run build -w shared",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "verify:conventions": "./scripts/verify-conventions.sh",
    "verify:workspace": "./scripts/verify-workspace-setup.sh",
    "clear:packages": "find . -type d -name \"node_modules\" -prune -exec rm -rf {} + && find . -type f -name \"package-lock.json\" -delete",
    "db:migrate": "make db-migrate",
    "db:generate": "make db-generate",
    "db:seed": "make db-seed",
    "db:seed:test": "make db-seed-test",
    "db:studio": "make db-studio",
    "test:e2e": "npm run e2e -w e2e",
    "test:e2e:headed": "npm run e2e:headed -w e2e",
    "test:e2e:ui": "npm run e2e:ui -w e2e",
    "test:e2e:failed": "npm run e2e:failed -w e2e",
    "test:e2e:grep": "npm run e2e:grep -w e2e",
    "test:e2e:report": "npm run e2e:report -w e2e",
    "test:e2e:codegen": "npm run e2e:codegen -w e2e",
    "test:e2e:trace": "npm run e2e:trace -w e2e",
    "test:e2e:serial": "npm run e2e:serial -w e2e"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testcontainers/postgresql": "^11.11.0",
    "@types/node": "^25.0.6",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/eslint-plugin": "^1.6.6",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "testcontainers": "^11.11.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
